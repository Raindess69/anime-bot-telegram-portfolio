# Получите токен у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# Опционально: путь к SQLite-базе (по умолчанию — bot.db в корне)
DB_PATH=bot.db

# Опционально: язык по умолчанию для новых пользователей (ru/en/uk)
DEFAULT_LANG=ru

# Опционально: токен партнера Kodik (kodik.cc)
KODIK_TOKEN=

# Опционально: прокси для запросов к Jikan (api.jikan.moe), через запятую (host:port:user:pass)
JIKAN_PROXIES=
