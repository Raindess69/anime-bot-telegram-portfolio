# --- Required ---
# Get one from @BotFather in Telegram
BOT_TOKEN=your_telegram_bot_token_here

# --- Optional ---
# Path to SQLite DB (default: bot.db in project root)
DB_PATH=bot.db

# Default UI language for new users: ru | en | uk
DEFAULT_LANG=ru

# Kodik partner token (register at https://kodik.cc/).
# Leave empty to disable Kodik: the scheduler will silently skip that source
# and no in-Telegram player button will be shown on cards.
KODIK_TOKEN=
